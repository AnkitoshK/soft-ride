{
  "version": 2,
  "rewrites": [
    { "source": "/api/bookings.php", "destination": "/api/bookings" },
    { "source": "/api/messages.php", "destination": "/api/messages" },
    { "source": "/api/admin_login.php", "destination": "/api/admin_login" },
    { "source": "/api/admin_logout.php", "destination": "/api/admin_logout" },
    { "source": "/api/admin_data.php", "destination": "/api/admin_data" },
    { "source": "/api/admin_booking_status.php", "destination": "/api/admin_booking_status" },
    { "source": "/api/admin_message_delete.php", "destination": "/api/admin_message_delete" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
